{
  "name": "@jgb-solutions/pick-object",
  "version": "0.1.0",
  "description": "A Prisma-like object selection utility.",
  "license": "MIT",
  "author": "JGB Solutions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jgb-solutions/pick-object.git"
  },
  "homepage": "https://github.com/jgb-solutions/pick-object#readme",
  "bugs": "https://github.com/jgb-solutions/pick-object/issues",
  "keywords": [
    "pick",
    "select",
    "prisma",
    "typescript",
    "object"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "bun@1.4.5",
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "bun check",
    "test": "bun test",
    "format": "bun fmt .",
    "format:check": "bun fmt --check .",
    "check:package": "bun scripts/check-package.ts",
    "bench": "bun scripts/bench.ts",
    "prepublishOnly": "bun run build && bun run check:package"
  },
  "devDependencies": {
    "@types/bun": "1.4.5",
    "typescript": "6.0.3"
  }
}
